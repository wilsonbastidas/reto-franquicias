# ---------------------------------------------------------------------------
# Copia este archivo como ".env" y ajusta los valores que necesites.
#   PowerShell: Copy-Item .env.example .env
# ---------------------------------------------------------------------------

# --- PostgreSQL ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=franchises_db
POSTGRES_PORT=5432
DB_SCHEMA=public
TZ=America/Bogota

# --- LocalStack ---
LOCALSTACK_PORT=4566
AWS_REGION=us-east-1
SECRET_NAME=franchises/db-credentials

# Solo si tu edición de LocalStack lo requiere:
# LOCALSTACK_AUTH_TOKEN=
